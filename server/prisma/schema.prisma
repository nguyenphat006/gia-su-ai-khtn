generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  username           String        @unique
  email              String?       @unique
  displayName        String
  passwordHash       String
  role               Role          @default(STUDENT)
  status             AccountStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(true)
  lastLoginAt        DateTime?

  classId            String?
  class              Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)

  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  stats              UserStats?
  xpLogs             XpLog[]
  authSessions       AuthSession[]
  chatSessions       ChatSession[]

  arenaResults       ArenaResult[]
  quizHistories      QuizHistory[]
  challenges         UserChallenge[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([role, status])
  @@index([classId])
}

model Class {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  grade        Int
  academicYear String

  users        User[]
  questions    QuestionBank[]
  flashcards   FlashcardDeck[]
  mindmaps     MindmapData[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, academicYear])
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentCode String   @unique
  grade       Int
  avatarUrl   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeacherProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeCode String?  @unique
  subject      String?
  avatarUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserStats {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp       Int       @default(0)
  weeklyXp      Int       @default(0)
  points        Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?

  updatedAt     DateTime  @updatedAt
}

model XpLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Int
  action      XpAction
  referenceId String?

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, expiresAt])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum XpAction {
  CHAT_AI
  COMPLETE_QUIZ
  WIN_ARENA
  DAILY_LOGIN
  ADMIN_BONUS
  QUEST_COMPLETED
}

model Challenge {
  id          String   @id @default(uuid())
  key         String   @unique // Ví dụ: S_GIA_CAU_HOI, CHIEN_BINH_TRI_TUE
  name        String
  description String
  xpReward    Int      @default(0)
  pointsReward Int     @default(0)
  goal        Int      @default(1) // Số lần cần thực hiện
  type        ChallengeType @default(DAILY)

  userChallenges UserChallenge[]
}

enum ChallengeType {
  DAILY
  ONCE
  WEEKLY
}

model UserChallenge {
  id           String    @id @default(uuid())
  userId       String
  challengeId  String
  progress     Int       @default(0)
  isCompleted  Boolean   @default(false)
  lastCompletedAt DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, challengeId])
}

// ========================
// AI CHAT & DYNAMIC CONFIG
// ========================

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?  
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  tags      String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String
  role        ChatRole
  content     String      @db.Text
  attachments Json?       
  createdAt   DateTime    @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ChatRole {
  USER
  MODEL
  SYSTEM
}

// ========================
// REVISION (ÔN TẬP)
// ========================

// Ngân hàng câu hỏi
model QuestionBank {
  id               String          @id @default(uuid())
  grade            Int?            // Khối (6, 7, 8, 9)
  classId          String?   
  topic            String   
  type             String   
  difficulty       String   
  content          String          @db.Text
  options          Json?    
  correctAnswer    String   
  explanation      String?         @db.Text
  isActive         Boolean         @default(true)
  status           QuestionStatus  @default(APPROVED) // PENDING, APPROVED, REJECTED
  sourceDocumentId String?
  createdAt        DateTime        @default(now())

  class            Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Lịch sử tải sách/tài liệu
model SourceDocument {
  id           String         @id @default(uuid())
  filename     String
  grade        Int?
  topic        String?
  status       DocumentStatus @default(PROCESSING)
  totalChunks  Int            @default(0)
  parsedChunks Int            @default(0)
  rawText      String?        @db.Text
  createdAt    DateTime       @default(now())
  
  questions    QuestionBank[]
}

enum DocumentStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// Bộ Flashcard
model FlashcardDeck {
  id          String   @id @default(uuid())
  grade       Int?
  classId     String?
  topic       String
  title       String
  cards       Json     
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
}

// Sơ đồ tư duy
model MindmapData {
  id          String   @id @default(uuid())
  grade       Int?
  classId     String?
  topic       String
  title       String
  markdown    String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
}

// Lưu lịch sử bài thi
model QuizHistory {
  id              String   @id @default(uuid())
  userId          String
  quizType        String   // CHINH_PHUC hoặc FLASHCARD_QUIZ
  totalQuestions  Int
  correctCount    Int
  xpEarned        Int
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========================
// ARENA (ĐẤU TRƯỜNG TRÍ TUỆ)
// ========================

model ArenaResult {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  score      Int      // Điểm đạt được
  mode       String   // "PVP" hoặc "AI"
  winner     Boolean  // Thắng hay thua
  opponent   String   // Tên đối thủ (username hoặc "Gia sư AI")
  topic      String?  // Chủ đề trận đấu
  xpEarned   Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([mode, createdAt])
  @@index([score])
}